# NeoWallet environment template
# Copy to .env and fill in real values. Do not commit .env.

# Backend
NEOWALLET_PROFILE=dev
NEOWALLET_DB_URL=jdbc:postgresql://localhost:5432/neowallet_dev
NEOWALLET_DB_USER=neowallet
NEOWALLET_DB_PASSWORD=change_me
NEOWALLET_REDIS_HOST=localhost
NEOWALLET_REDIS_PORT=6379
NEOWALLET_REDIS_PASSWORD=
NEOWALLET_REDIS_DB=0
# Base64-encoded HMAC-SHA256 key (>= 256 bits / 32 bytes)
NEOWALLET_JWT_SECRET=change_me_to_base64_encoded_key
NEOWALLET_OTP_PROVIDER=stub

# SendGrid OTP provider (set NEOWALLET_OTP_PROVIDER=sendgrid to enable)
# Never commit real values.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# AI
AI_PROVIDER=stub
AI_API_KEY=
AI_MODEL=

# Flutter
API_BASE_URL=http://localhost:8080
