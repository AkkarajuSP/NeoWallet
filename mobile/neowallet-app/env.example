# NeoWallet mobile app environment template
# Copy to .env and set values appropriate for the environment.
# Do NOT commit .env.

# Local / emulator development (use 10.0.2.2 for Android emulator)
API_BASE_URL=http://localhost:8080
# For physical-device LAN development, point at your dev host, e.g.:
# API_BASE_URL=http://<your-dev-host-ip>:8080
